# Configuración Global de Bases de Datos PostgreSQL
DB_USER=postgres
DB_PASSWORD=root
DB_PORT=5432
DB_HOST_DOCENTES=docentes-db
DB_HOST_CURSOS=cursos-db
DB_HOST_ESTUDIANTES=estudiantes-db
DB_HOST_MATRICULAS=matriculas-db
DB_HOST_NOTAS=notas-db

# Nombres de bases de datos independientes por servicio
DB_NAME_DOCENTES=docentes_db
DB_NAME_CURSOS=cursos_db
DB_NAME_ESTUDIANTES=estudiantes_db
DB_NAME_MATRICULAS=matriculas_db
DB_NAME_NOTAS=notas_db

## URLs de servicios de comunicación entre servicios
DOCENTES_SERVICE_URL=http://docentes-service:5001
CURSOS_SERVICE_URL=http://cursos-service:5002
ESTUDIANTES_SERVICE_URL=http://estudiantes-service:5003
MATRICULAS_SERVICE_URL=http://matriculas-service:5004
NOTAS_SERVICE_URL=http://notas-service:5005